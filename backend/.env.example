# Server Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
# Example for local MongoDB: mongodb://127.0.0.1:27017/pet_care_manager
# Example for MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/pet_care_manager?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/pet_care_manager

# Client URL for CORS configuration
CLIENT_URL=http://localhost:5173
